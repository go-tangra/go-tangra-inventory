{
  "name": "freya-inventory-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "lint": "eslint . && vue-tsc --noEmit -p tsconfig.app.json",
    "test:unit": "vitest run",
    "gen:api": "openapi-typescript ../api/openapi/inventory.yaml -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@casl/ability": "^7.0.1",
    "@casl/vue": "^3.0.1",
    "@mdi/font": "^7.4.47",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "vuetify": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@module-federation/vite": "^1.22.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.6.0",
    "globals": "^16.0.0",
    "jsdom": "^27.0.0",
    "openapi-typescript": "^7.11.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^8.3.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.1",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.2.4"
  }
}
